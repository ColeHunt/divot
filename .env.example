# Port the Node server listens on
PORT=8080

# Directory the SQLite database lives in (created if missing)
DATA_DIR=./data

# Set to production on the server. Also gates the Secure flag on session cookies,
# so this must be set (behind HTTPS) once divot is deployed.
NODE_ENV=development

# Optional — password reset emails, sent via Resend (resend.com), free tier.
# Without RESEND_API_KEY, "forgot password" still works: it just logs the
# reset link to the server console instead of emailing it.
RESEND_API_KEY=
# Defaults to Resend's shared test sender if unset. Set this to something on
# a domain you've verified with Resend once you have one, e.g.
# "divot <noreply@colehunt.com>".
EMAIL_FROM=
